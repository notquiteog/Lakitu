#!/bin/sh
# Start the game Hookshot Builder wrote, from that folder, without the AppImage's libraries.
# The builder AppImage calls this for --play. The window's Play button does the same thing.
#
#   hookshot-launch                      the out= folder in ~/.config/hookshot/builder.ini
#   hookshot-launch /path/to/the/game    that folder
#   hookshot-launch <folder> --game <key>  that game's own folder: <folder> for the default game, <folder>-<key> for
#                                        another (nx2/game_folders.py; the launcher's games[] adds --game <key>)
#   HOOKSHOT_LAUNCH_CONFIG=<file>        read that ini instead (a test)
set -eu

ini_path() {
    if [ -n "${HOOKSHOT_LAUNCH_CONFIG:-}" ]; then
        printf '%s\n' "$HOOKSHOT_LAUNCH_CONFIG"
    else
        printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/hookshot/builder.ini"
    fi
}

# the last out= line, as the builder keeps the last value it wrote
out_of() {
    out=
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in
            out=*) out=${line#out=} ;;
        esac
    done < "$1"
    [ -n "$out" ] || return 1
    printf '%s\n' "$out"
}

ready() {
    [ -n "${1:-}" ] && [ -f "$1/image.bin" ] && { [ -x "$1/bin/hookshot" ] || [ -f "$1/hookshot" ]; }
}

# (the default game's key: the committed profile header's, the game whose folder never takes a suffix)
default_game() {
    for root in "${HOOKSHOT_TOOLS:-}" "$(dirname "$0")/../.."; do
        [ -n "$root" ] && [ -f "$root/game/game_profile.h" ] || continue
        sed -n 's/^#define GAME_PROFILE_KEY "\([a-z0-9]*\)"$/\1/p' "$root/game/game_profile.h" | head -n 1
        return
    done
}

folder= game=
while [ $# -gt 0 ]; do
    case $1 in
        --game)
            game=${2:-}
            shift
            [ $# -gt 0 ] && shift
            ;;
        *)
            [ -n "$folder" ] || folder=$1
            shift
            ;;
    esac
done
case $game in
    '') ;;
    *[!a-z0-9]* | ?????????????????*)
        echo "Hookshot: --game takes a game's key (a to z, 0 to 9, up to 16): $game" >&2
        exit 2
        ;;
esac
if [ -z "$folder" ]; then
    ini=$(ini_path)
    if [ -f "$ini" ]; then
        folder=$(out_of "$ini") || folder=
    fi
fi

# (another game than the default one: its own folder beside the default game's)
if [ -n "$game" ] && [ -n "$folder" ]; then
    default=$(default_game)
    if [ -z "$default" ]; then
        echo "Hookshot: the default game's key was not found (game/game_profile.h): --game cannot pick a folder" >&2
        exit 2
    fi
fi
if [ -n "$game" ] && [ -n "$folder" ] && [ "$game" != "$default" ]; then
    while [ "${folder%/}" != "$folder" ]; do folder=${folder%/}; done
    folder="$folder-$game"
fi

if ! ready "$folder"; then
    echo "Hookshot: no built game to start. Build one with Hookshot Builder, or pass its folder." >&2
    # (HOOKSHOT_LAUNCH_CONFIG is a test: it must not open a dialog)
    if [ -z "${HOOKSHOT_LAUNCH_CONFIG:-}" ]; then
        if command -v zenity >/dev/null 2>&1; then
            zenity --error --title=Hookshot --text="No built game to start. Build one with Hookshot Builder first." || true
        elif command -v kdialog >/dev/null 2>&1; then
            kdialog --error "No built game to start. Build one with Hookshot Builder first." || true
        fi
    fi
    exit 1
fi

# The AppImage runtime and the builder put their own libraries on the search path. The game loads
# SDL from beside itself, so those names go before it starts. Same set as the builder's Play button.
names=$(env | awk -F= '$1 ~ /^(HOOKSHOT_|PYTHON|APPDIR|APPIMAGE|ARGV0|OWD)/ || $1 == "LD_LIBRARY_PATH" { print $1 }')
for name in $names; do
    unset "$name"
done

cd "$folder"
# (--play already chose Play: a game built when it asked about updates itself does not ask again)
export HOOKSHOT_NO_UPDATE_CHECK=1
if [ -x ./bin/hookshot ]; then
    exec ./bin/hookshot
fi
exec ./hookshot
