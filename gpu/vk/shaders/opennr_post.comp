#version 460
// (hookshot) The open neural rendering backend's output: the network's head on the frame (gpu/vk/vk_opennr.cpp).
//
// The head is an RGB residual on the frame's code values and one temporal blend logit (OpenDLSS-NR docs/network.md):
//   neural  = clamp(proxy + rgb / 4, 0, 1)                         spelled as upstream's composite spells it
//   weight  = clamp(sigmoid(logit) * blend_scale, 0, 1)            blend_scale: the model's own, a learned cap
//   neural  = lerp(neural, reprojected history, weight)            only where there is a history
//   history = truncate_to_half(neural)                             the next frame's input reads it
// then the style operator (Natural, Cinematic) and the intensity blend back toward the frame, as upstream's demo
// does after the blend. Its tone upgrade and display transform are left out: they put an LDR result back onto an
// HDR scene, and the frame here is LDR to begin with.
#extension GL_GOOGLE_include_directive : require
#include "opennr_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// ---- the styles: upstream's nrStyle, the HSL operator its demo applies for Natural (1) and Cinematic (2)
vec3 nrHsl(vec3 rgb) {
    float high = max(max(rgb.r, rgb.g), rgb.b);
    float low = min(min(rgb.r, rgb.g), rgb.b);
    float sum = high + low;
    float light = sum * 0.5;
    float hue = 0.0, saturation = 0.0;
    if (high > low) {
        float delta = high - low;
        saturation = light > 0.5 ? delta / ((2.0 - high) - low) : delta / sum;
        if (high == rgb.r) hue = fma(rgb.g - rgb.b, 1.0 / delta, rgb.g < rgb.b ? 6.0 : 0.0) / 6.0;
        else if (high == rgb.g) hue = fma(rgb.b - rgb.r, 1.0 / delta, 2.0) / 6.0;
        else hue = fma(rgb.r - rgb.g, 1.0 / delta, 4.0) / 6.0;
    }
    return vec3(hue, saturation, light);
}

float nrHue(float p, float q, float hue) {
    float h = hue;
    if (h < 0.0) h += 1.0;
    if (h > 1.0) h -= 1.0;
    if (h < uintBitsToFloat(0x3e2aaaabu)) return fma(h, (q - p) * 6.0, p);
    if (h < 0.5) return q;
    if (h < uintBitsToFloat(0x3f2aaaabu)) return fma((uintBitsToFloat(0x3f2aaaabu) - h) * (q - p), 6.0, p);
    return p;
}

vec3 nrRgb(vec3 hsl) {
    if (hsl.y <= 0.0) return vec3(hsl.z);
    float q = hsl.z < 0.5 ? hsl.z * (hsl.y + 1.0) : fma(-hsl.z, hsl.y, hsl.z + hsl.y);
    float p = (hsl.z + hsl.z) - q;
    return vec3(nrHue(p, q, hsl.x + uintBitsToFloat(0x3eaaaaabu)), nrHue(p, q, hsl.x),
                nrHue(p, q, hsl.x - uintBitsToFloat(0x3eaaaaabu)));
}

vec3 nrStyle(vec3 neural, float style, float tone) {
    float styleTone = clamp(tone, 0.0, 1.0);
    float exposure = style == 1.0 ? -0.1 * styleTone : 0.0;
    float contrast = style == 1.0 ? -0.25 * styleTone : 0.0;
    float saturation = style == 1.0 ? -0.1 * styleTone : -0.15 * styleTone;
    vec3 color;
    for (int c = 0; c < 3; c++) {
        float value = clamp(neural[c], 0.0, 1.0);
        float exposed = clamp(value * exp2(exposure), 0.0, 1.0);
        float square = exposed * exposed;
        float curveDelta = fma(square, 3.0 - (exposed + exposed), -exposed);
        float curved = clamp(fma(contrast, curveDelta, exposed), 0.0, 1.0);
        float firstGamma = exp2(log2(curved));
        color[c] = exp2(log2(max(0.0, firstGamma)));
    }
    vec3 hsl = nrHsl(color);
    vec3 adjusted = nrRgb(vec3(hsl.x, clamp(hsl.y * (saturation + 1.0), 0.0, 1.0), hsl.z));
    vec3 again = nrHsl(adjusted);
    return clamp(nrRgb(vec3(again.x, clamp(exp2(log2(again.y)), 0.0, 1.0), again.z)), vec3(0.0), vec3(1.0));
}

void main() {
    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= pc.valid_width || id.y >= pc.valid_height) return;
    vec3 proxy = imageLoad(in_color, ivec2(id)).rgb;
    uint feature = (id.y * pc.full_width + id.x) * 4u;
    vec3 h = vec3(head[feature], head[feature + 1u], head[feature + 2u]);
    vec3 neural = clamp(fma(h, vec3(0.03125), fma(proxy, vec3(0.125), vec3(-0.0625))) * 8.0 + 0.5, vec3(0.0), vec3(1.0));
    if (has_history(vec2(id))) {
        float scale = clamp(pc.blend_scale, 0.0, 1.0);
        float weight = clamp((1.0 / (1.0 + exp2(head[feature + 3u] * uintBitsToFloat(0xbfb8aa3bu)))) * scale, 0.0, 1.0);
        neural = fma(vec3(weight), history_sample(vec2(id)) - neural, neural);
    }
    vec3 history = vec3(truncateHalf(neural.r), truncateHalf(neural.g), truncateHalf(neural.b));
    imageStore(history_next, ivec2(id), vec4(history, 1.0));
    vec3 styled = pc.style != 0.0 ? nrStyle(history, pc.style, pc.local_tone) : history;
    vec3 published = history;
    if (pc.style != 0.0 || pc.intensity != 1.0)
        for (int c = 0; c < 3; c++)
            published[c] = truncateHalf(clamp(fma(pc.intensity, styled[c] - proxy[c], proxy[c]), 0.0, 1.0));
    imageStore(out_color, ivec2(id), vec4(published, 1.0));
}
