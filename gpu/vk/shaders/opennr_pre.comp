#version 460
// (hookshot) The open neural rendering backend's input: the network's sixteen f32 lanes per padded pixel, from the
// window's frame (gpu/vk/vk_opennr.cpp). OpenDLSS-NR's docs/network.md is the table:
//   0-2 Gaussian noise from a hash of the PADDED coordinate and the seed, 3 constant 1, 4-6 the frame centred,
//   7-9 the reprojected previous output centred (a copy of 4-6 without one), 10 style / 128, 11 local tone,
//   12-14 the structure / skin / auto-mask triple, 15 zero.
// Outside the frame's rectangle the sampling coordinate is mirrored (2 * valid - x - 2) while the noise keeps the
// padded coordinate, so the padding is a reflected copy of the frame with its own noise.
//
// The frame is already a display image (the game tone-maps it), so it is its own proxy: its code values are the
// lanes, with no paper white and no shoulder, which upstream's demo needs only because its scene is HDR.
#extension GL_GOOGLE_include_directive : require
#include "opennr_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

float hashUniform(uint value) {
    uint mixed = value;
    mixed = (mixed >> ((mixed >> 28u) + 4u)) ^ mixed;
    mixed *= 0x108ef2d9u;
    uint integer = ((mixed >> 30u) ^ (mixed >> 8u)) + 1u;
    return float(integer) * uintBitsToFloat(0x33800000u);
}

vec3 gaussian3(uint x, uint y, uint seed) {
    uint base = (x * 0x8da6b343u) ^ (y * 0xd8163841u) ^ (seed * 0x9e3779b9u) ^ 0x243f6a88u;
    base = (base >> ((base >> 28u) + 4u)) ^ base;
    base *= 0x108ef2d9u;
    base = (base >> 22u) ^ base;
    float u0 = hashUniform(base * 0x2c9277b5u + 0xac564b05u);
    float u1 = hashUniform(base * 0xfa6dc5f9u + 0x4712a88eu);
    float u2 = hashUniform(base * 0xcaa5b80du + 0x21dd796bu);
    float u3 = hashUniform(base * 0x83232c31u + 0x3463e0acu);
    float radius0 = sqrt(log2(u0) * uintBitsToFloat(0x3f317218u) * -2.0);
    float radius1 = sqrt(log2(u2) * uintBitsToFloat(0x3f317218u) * -2.0);
    float tau = uintBitsToFloat(0x40c90fdbu);
    return vec3(roundF16(radius0 * cos(u1 * tau)), roundF16(radius0 * sin(u1 * tau)), roundF16(radius1 * cos(u3 * tau)));
}

void main() {
    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= pc.full_width || id.y >= pc.full_height) return;
    int rx = id.x < pc.valid_width ? int(id.x) : 2 * int(pc.valid_width) - int(id.x) - 2;
    int ry = id.y < pc.valid_height ? int(id.y) : 2 * int(pc.valid_height) - int(id.y) - 2;
    ivec2 at = clamp(ivec2(rx, ry), ivec2(0), ivec2(pc.valid_width, pc.valid_height) - 1);
    vec3 current = centred(imageLoad(in_color, at).rgb);
    vec3 noise = gaussian3(id.x, id.y, pc.seed);
    // lanes 7-9: without a history (a reset, single-frame mode, a pixel whose previous position was off screen) the
    // current frame stands in, as on a first frame
    vec3 previous = current;
    if (has_history(vec2(at))) previous = centred(history_sample(vec2(at)));
    uint base = (id.y * pc.full_width + id.x) * 4u;
    features[base + 0u] = vec4(noise, 1.0);
    features[base + 1u] = vec4(current, previous.r);
    features[base + 2u] = vec4(previous.g, previous.b, pc.style / 128.0, roundF16(pc.local_tone));
    bool masked = pc.auto_mask != 0u;
    features[base + 3u] = vec4(roundF16(masked ? 1.0 : pc.local_structure),
                               roundF16(masked ? (pc.skin < 0.0 ? pc.local_structure : pc.skin) : -1.0),
                               roundF16(masked ? pc.local_structure : -1.0), 0.0);
}
